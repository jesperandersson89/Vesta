{
  "name": "vesta-client",
  "version": "0.2.0",
  "description": "TypeScript client library for the Vesta protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "prepack": "npm run clean && npm run build",
    "test": "tsc && node --test"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vesta",
    "protocol",
    "websocket",
    "event-sourcing"
  ],
  "license": "MIT",
  "author": "Jesper Andersson",
  "homepage": "https://github.com/jesperandersson89/Vesta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesperandersson89/Vesta.git",
    "directory": "clients/vesta-client-ts"
  },
  "bugs": {
    "url": "https://github.com/jesperandersson89/Vesta/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
