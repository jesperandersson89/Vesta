<Project Sdk="Microsoft.NET.Sdk"><!-- Properties inherited from Directory.Build.props -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VestaProtocol.Client</PackageId>
    <Description>.NET client library for the Vesta protocol: WebSocket connection, Ed25519 identity, offline outbox and local SQLite cache.</Description>
    <PackageTags>vesta;protocol;websocket;event-sourcing;offline-first</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VestaCore\VestaCore.csproj" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
