<Project Sdk="Microsoft.NET.Sdk"><!-- All shared properties (TFM, nullable, etc.) come from Directory.Build.props -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VestaProtocol.Core</PackageId>
    <Description>Shared protocol types, event/identity primitives, and conflict-resolution helpers for the Vesta protocol.</Description>
    <PackageTags>vesta;protocol;event-sourcing;crdt</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML doc comments on public members become CS1591 once GenerateDocumentationFile is on;
         TreatWarningsAsErrors would otherwise turn every one into a build failure. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="jsoncanonicalizer" Version="1.0.0" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VestaCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
